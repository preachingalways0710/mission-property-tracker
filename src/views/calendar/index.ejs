<%- include('../partials/header') %>
<div class="page-heading">
  <div>
    <p class="eyebrow">Due dates</p>
    <h1><%= monthLabel %></h1>
  </div>
  <div class="actions">
    <a class="button" href="/calendar?month=<%= prev %>">Previous</a>
    <a class="button" href="/calendar?month=<%= next %>">Next</a>
  </div>
</div>

<section class="calendar" data-calendar data-admin="<%= isAdmin ? 'true' : 'false' %>">
  <% ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'].forEach(day => { %>
    <div class="weekday"><%= day %></div>
  <% }) %>
  <% days.forEach(day => { %>
    <div class="day <%= day.inMonth ? '' : 'muted-day' %>" data-date="<%= day.date %>">
      <div class="day-head">
        <span><%= day.label %></span>
        <% if (isAdmin) { %><a class="icon-link" href="/tasks?due_date=<%= day.date %>" title="Add task">+</a><% } %>
      </div>
      <% day.tasks.forEach(task => { %>
        <article class="calendar-task <%= task.status %>" draggable="<%= isAdmin ? 'true' : 'false' %>" data-task-id="<%= task.id %>">
          <strong><%= task.title %></strong>
          <small><%= task.worker_name %></small>
          <% if (task.status !== 'done') { %>
            <form method="post" action="/tasks/<%= task.id %>/mark-done?_method=PATCH">
              <button class="mini-button" type="submit">Done</button>
            </form>
          <% } %>
        </article>
      <% }) %>
    </div>
  <% }) %>
</section>
<%- include('../partials/footer') %>
