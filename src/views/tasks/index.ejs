<%- include('../partials/header') %>
<div class="page-heading">
  <div>
    <p class="eyebrow">Mission work</p>
    <h1>Tasks</h1>
  </div>
  <a class="button" href="/calendar">Calendar</a>
</div>

<% if (isAdmin) { %>
  <section class="toolbar-form">
    <h2><%= task ? 'Edit Task' : 'New Task' %></h2>
    <form class="form grid-form" method="post" action="<%= task ? `/tasks/${task.id}?_method=PUT` : '/tasks' %>">
      <label>Title <input name="title" required value="<%= task?.title || '' %>"></label>
      <label>Worker
        <select name="assigned_to" required>
          <% workers.forEach(worker => { %>
            <option value="<%= worker.id %>" <%= task?.assigned_to === worker.id ? 'selected' : '' %>><%= worker.name %></option>
          <% }) %>
        </select>
      </label>
      <label>Domain
        <select name="domain_id">
          <option value="">None</option>
          <% domains.forEach(domain => { %>
            <option value="<%= domain.id %>" <%= task?.domain_id === domain.id ? 'selected' : '' %>><%= domain.name %></option>
          <% }) %>
        </select>
      </label>
      <label>Due Date <input name="due_date" type="date" value="<%= helpers.toDateInput(task?.due_date) || prefillDueDate %>"></label>
      <label>Status
        <select name="status">
          <option value="todo" <%= task?.status === 'todo' ? 'selected' : '' %>>To Do</option>
          <option value="in_progress" <%= task?.status === 'in_progress' ? 'selected' : '' %>>In Progress</option>
          <option value="done" <%= task?.status === 'done' ? 'selected' : '' %>>Done</option>
        </select>
      </label>
      <label>Priority
        <select name="priority">
          <option value="normal" <%= !task?.priority || task?.priority === 'normal' ? 'selected' : '' %>>Normal</option>
          <option value="high" <%= task?.priority === 'high' ? 'selected' : '' %>>High</option>
          <option value="low" <%= task?.priority === 'low' ? 'selected' : '' %>>Low</option>
        </select>
      </label>
      <label class="wide">Description <textarea name="description" rows="3"><%= task?.description || '' %></textarea></label>
      <button class="button primary" type="submit"><%= task ? 'Save Task' : 'Create Task' %></button>
      <% if (task) { %><a class="button ghost" href="/tasks">Cancel</a><% } %>
    </form>
    <% if (task) { %>
      <form method="post" action="/tasks/<%= task.id %>?_method=DELETE">
        <button class="button danger" type="submit">Delete Task</button>
      </form>
    <% } %>
  </section>
<% } %>

<%- include('../partials/task-board', { lists, helpers }) %>
<%- include('../partials/footer') %>
