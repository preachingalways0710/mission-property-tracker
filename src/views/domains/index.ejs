<%- include('../partials/header') %>
<div class="page-heading">
  <div>
    <p class="eyebrow">Admin</p>
    <h1>Task Domains</h1>
  </div>
</div>

<section class="toolbar-form">
  <form class="form inline-form" method="post" action="/domains">
    <label>Name <input name="name" required></label>
    <button class="button primary" type="submit">Add Domain</button>
  </form>
</section>

<section class="list">
  <% domains.forEach(domain => { %>
    <div class="row">
      <span><strong><%= domain.name %></strong></span>
      <div class="row-actions">
        <span class="pill <%= domain.is_active ? 'approved' : 'pending' %>"><%= domain.is_active ? 'active' : 'hidden' %></span>
        <form method="post" action="/domains/<%= domain.id %>/toggle?_method=PATCH">
          <button class="button ghost" type="submit"><%= domain.is_active ? 'Hide' : 'Restore' %></button>
        </form>
      </div>
    </div>
  <% }) %>
</section>
<%- include('../partials/footer') %>
