<%- include('../partials/header') %>
<div class="page-heading">
  <div>
    <p class="eyebrow">Record only</p>
    <h1>Pay Ledger</h1>
  </div>
</div>

<% if (isAdmin) { %>
  <section class="toolbar-form">
    <form class="form grid-form" method="post" action="/pay-ledger">
      <label>Worker
        <select name="user_id">
          <% workers.forEach(worker => { %><option value="<%= worker.id %>"><%= worker.name %></option><% }) %>
        </select>
      </label>
      <label>Start <input name="period_start" type="date" required></label>
      <label>End <input name="period_end" type="date" required></label>
      <label>Rate <input name="rate" type="number" step="0.01" min="0" required></label>
      <label>Status
        <select name="status"><option value="pending">Pending</option><option value="paid">Paid</option></select>
      </label>
      <button class="button primary" type="submit">Create Pay Period</button>
    </form>
  </section>
<% } %>

<section class="table-wrap">
  <table>
    <thead><tr><th>Worker</th><th>Period</th><th>Hours</th><th>Rate</th><th>Owed</th><th>Status</th><th></th></tr></thead>
    <tbody>
      <% entries.forEach(entry => { %>
        <tr>
          <td><%= entry.worker_name %></td>
          <td><%= helpers.formatDate(entry.period_start) %> to <%= helpers.formatDate(entry.period_end) %></td>
          <td><%= entry.hours_total %></td>
          <td><%= helpers.money(entry.rate) %></td>
          <td><%= helpers.money(entry.amount_owed) %></td>
          <td><span class="pill <%= entry.status %>"><%= entry.status %></span></td>
          <td>
            <% if (isAdmin && entry.status !== 'paid') { %>
              <form method="post" action="/pay-ledger/<%= entry.id %>/paid"><button class="button ghost" type="submit">Mark Paid</button></form>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</section>
<%- include('../partials/footer') %>
