<%- include('../partials/header') %>
<div class="page-heading">
  <div>
    <p class="eyebrow">Arrival and departure</p>
    <h1>Clock</h1>
  </div>
</div>

<% if (isWorker) { %>
  <section class="clock-panel">
    <% if (openEvent) { %>
      <p>Clocked in since <strong><%= helpers.formatDateTime(openEvent.clock_in) %></strong></p>
      <form method="post" action="/clock/out"><button class="button primary large" type="submit">Clock Out</button></form>
    <% } else { %>
      <p>You are not currently clocked in.</p>
      <form method="post" action="/clock/in"><button class="button primary large" type="submit">Clock In</button></form>
    <% } %>
  </section>
<% } %>

<section>
  <h2><%= isAdmin ? 'Clock Events' : 'Your Clock Events' %></h2>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Worker</th><th>Clock In</th><th>Clock Out</th><th>Hours</th><th>Status</th></tr></thead>
      <tbody>
        <% events.forEach(event => { %>
          <tr>
            <td><%= event.worker_name %></td>
            <td><%= helpers.formatDateTime(event.clock_in) %></td>
            <td><%= event.clock_out ? helpers.formatDateTime(event.clock_out) : '—' %></td>
            <td><%= event.clock_out ? helpers.decimalHours(event.clock_in, event.clock_out) : '—' %></td>
            <td><span class="pill <%= event.clock_out ? 'done' : 'pending' %>"><%= event.clock_out ? 'complete' : 'clocked in' %></span></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>
<%- include('../partials/footer') %>
